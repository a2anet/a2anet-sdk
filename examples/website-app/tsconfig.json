{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "jsx": "react-jsx",
        "baseUrl": ".",
        // For the `.css` import and the dev server's own types.
        "types": ["vite/client"],
        // Against the package's source, so `typecheck` does not need a build first.
        "paths": {
            "@a2anet/react": ["../../packages/react/src/index.ts"]
        }
    },
    "include": ["server/**/*", "src/**/*", "vite.config.ts"],
    "exclude": ["node_modules"]
}
