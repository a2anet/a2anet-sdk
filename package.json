{
    "name": "a2anet-sdk",
    "private": true,
    "type": "module",
    "workspaces": ["packages/*"],
    "scripts": {
        "build": "bun --filter '@a2anet/*' build",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "typecheck": "bun --filter '@a2anet/*' typecheck",
        "test": "bun --filter '@a2anet/*' test",
        "test:coverage": "bun --filter '@a2anet/*' test:coverage"
    },
    "packageManager": "bun@1.3.5",
    "devDependencies": {
        "@biomejs/biome": "^1.9.0",
        "@types/bun": "latest",
        "typescript": "^5.7.0"
    },
    "trustedDependencies": ["@biomejs/biome"]
}
